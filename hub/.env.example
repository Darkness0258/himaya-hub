# Copy to hub/.env (never commit the real file). Every line is optional.

# --- Sign-in -------------------------------------------------------------
# The dashboard asks for an admin key. If you leave this empty the hub creates one on first start,
# prints it once and saves it to data/admin_key.txt. On cloud hosts set it here so it survives restarts.
#HIMAYA_ADMIN_KEY=

# --- Network -------------------------------------------------------------
#PORT=8000
# Docker only: the host computer's real LAN address (the container cannot know it).
#HIMAYA_LAN_IP=192.168.1.20
# Address phones/PCs use when they are NOT on your Wi-Fi (DuckDNS, a WireGuard IP, a cloud URL).
#HIMAYA_PUBLIC_URL=https://my-hub.example.com
# Time zone for bedtime schedules, e.g. Asia/Karachi (default: this computer's time zone)
#HIMAYA_TIMEZONE=Asia/Karachi

# --- Website filtering (hub DNS) -----------------------------------------
#HIMAYA_DNS_ENABLED=1
#HIMAYA_DNS_PORT=5300            # use 53 if you want PCs to use the hub as their DNS server
#HIMAYA_DNS_UPSTREAM=1.1.1.3     # family-safe resolver the hub forwards allowed lookups to

# --- Storage -------------------------------------------------------------
# Optional PostgreSQL / Supabase. Leave empty for the built-in SQLite file in data/.
# If this was ever shared or committed, rotate the database password.
#DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Retention -----------------------------------------------------------
#HIMAYA_EVENT_RETENTION_DAYS=30
#HIMAYA_SNAPSHOT_RETENTION_DAYS=7
