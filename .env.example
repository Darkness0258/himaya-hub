# Used by docker compose (copy to .env in this folder). Never commit the real file.
# The hub's own settings are documented in hub/.env.example.

# The Docker host's real LAN address, so enrollment links work from other devices.
HIMAYA_LAN_IP=192.168.1.20

# Admin key for the dashboard. Leave empty to have the hub generate one:
#   docker compose exec himaya-hub cat /app/data/admin_key.txt
HIMAYA_ADMIN_KEY=

# Address to use away from home (optional)
HIMAYA_PUBLIC_URL=

# Time zone for bedtime schedules
HIMAYA_TIMEZONE=UTC

# Optional PostgreSQL / Supabase connection string
DATABASE_URL=
