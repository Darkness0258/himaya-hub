<?xml version="1.0" encoding="utf-8"?>
<!-- Only what Himaya actually uses: lock the screen, and erase a lost phone. (The first version listed
     tags that are not valid policies, so "lock" would have been refused.) -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
    </uses-policies>
</device-admin>
